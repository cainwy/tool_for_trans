{
  "input": {
    "mode": "clipboard",
    "copyDelayMs": 160,
    "copyTimeoutMs": 900,
    "restoreClipboard": true,
    "maxChars": 5000,
    "mergePdfLineBreaks": true,
    "preserveCodeLikeText": true
  },
  "translation": {
    "provider": "mymemory",
    "targetLang": "ZH-HANS",
    "alternateTargetLangWhenInputLooksChinese": "EN-US",
    "sourceLang": "",
    "timeoutMs": 8000,

    "myMemoryEndpoint": "https://api.mymemory.translated.net/get",
    "myMemoryEmail": "",
    "myMemoryKey": "",

    "microsoftEndpoint": "https://api.cognitive.microsofttranslator.com/translate?api-version=3.0",
    "microsoftApiKeyEnv": "AZURE_TRANSLATOR_KEY",
    "microsoftApiKey": "",
    "microsoftRegionEnv": "AZURE_TRANSLATOR_REGION",
    "microsoftRegion": "",

    "baiduEndpoint": "https://fanyi-api.baidu.com/api/trans/vip/translate",
    "baiduAppIdEnv": "BAIDU_TRANSLATE_APPID",
    "baiduAppId": "",
    "baiduKeyEnv": "BAIDU_TRANSLATE_KEY",
    "baiduKey": "",

    "apiKeyEnv": "DEEPL_API_KEY",
    "apiKey": "",
    "endpoint": "https://api-free.deepl.com/v2/translate",
    "deeplModelType": "latency_optimized",
    "deeplSplitSentences": "nonewlines",

    "libreTranslateEndpoint": "http://127.0.0.1:5000/translate",
    "libreTranslateApiKey": ""
  },
  "overlay": {
    "maxWidthPx": 620,
    "maxHeightPx": 520,
    "minWidthPx": 220,
    "paddingPx": 14,
    "offsetX": 16,
    "offsetY": 18,
    "opacity": 0.96,
    "fontName": "Microsoft YaHei UI",
    "fontSize": 10.5,
    "copyOnRightClick": true
  }
}
