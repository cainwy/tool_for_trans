    "icibaWebEndpointPrefix": "https://ifanyi.iciba.com/index.php?c=trans&m=fy&client=6&auth_user=key_web_fanyi&sign=",
    "icibaWebSecretPrefix": "6key_web_fanyiifanyiweb8hc9s98e",

    "myMemoryEndpoint": "https://api.mymemory.translated.net/get",
    "myMemoryEmail": "",
    "myMemoryKey": "",

    "microsoftEndpoint": "https://api.cognitive.microsofttranslator.com/translate?api-version=3.0",
    "microsoftApiKeyEnv": "AZURE_TRANSLATOR_KEY",
